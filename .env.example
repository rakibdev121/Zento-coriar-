# Copy to .env and fill in. NEVER commit .env.

ENVIRONMENT=development

# Local Postgres (see docker-compose.yml) ...
DATABASE_URL=postgresql+psycopg://zento:zento@localhost:5432/zento
# ... or Supabase (Dashboard > Connect). URL-encode special characters in the password.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=720
CURRENCY=BDT
# Comma-separated; only needed if the frontend is served from a different origin
CORS_ORIGINS=

# Admin panel (/admin). On startup this account is created, or promoted if the email already exists.
# Use a strong password (8+ chars, letters and numbers). Remove ADMIN_PASSWORD from the host after first sign-in if you like.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Rider app: share of the parcel price a rider earns on delivery (0.20 = 20%) and the daily goal shown in the app
RIDER_COMMISSION_RATE=0.20
RIDER_DAILY_GOAL=2000

# Wallet: smallest deposit / withdrawal (taka) and the numbers customers send deposit money to (leave empty to hide a method)
WALLET_MIN_DEPOSIT=50
WALLET_MIN_WITHDRAW=100
PAY_BKASH=
PAY_NAGAD=
PAY_ROCKET=
PAY_BANK=
